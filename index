// =============================== MOON PHASE ===============================
function renderMoon(){
  let now=new Date(); let knownNew=new Date('2000-01-06T18:14:00Z'); let SYNODIC=29.530588853; let elapsed=(now-knownNew)/(1000*60*60*24); let phase=((elapsed%SYNODIC)+SYNODIC)%SYNODIC; let illumination=50*(1-Math.cos(2*Math.PI*phase/SYNODIC)); let pct=Math.round(illumination);
  let phaseName,emoji; if(phase<1.85){phaseName='New Moon';emoji='🌑';} else if(phase<5.54){phaseName='Waxing Crescent';emoji='🌒';} else if(phase<9.22){phaseName='First Quarter';emoji='🌓';} else if(phase<12.91){phaseName='Waxing Gibbous';emoji='🌔';} else if(phase<16.61){phaseName='Full Moon';emoji='🌕';} else if(phase<20.30){phaseName='Waning Gibbous';emoji='🌖';} else if(phase<23.99){phaseName='Last Quarter';emoji='🌗';} else if(phase<27.68){phaseName='Waning Crescent';emoji='🌘';} else{phaseName='New Moon';emoji='🌑';}
  let daysUntilFull=phase<14.77?(14.77-phase).toFixed(1):(SYNODIC-phase+14.77).toFixed(1); let daysUntilNew=phase>0.5?(SYNODIC-phase).toFixed(1):(0.5-phase).toFixed(1);
  document.getElementById('moonOutput').innerHTML=`<div class="moon-display"><div class="moon-emoji">${emoji}</div><div class="moon-phase-name">${phaseName}</div><div class="moon-illumination">Illumination: <span>${pct}%</span></div></div><hr/><div><div class="info-pair"><span class="info-label">Lunar Day</span><span class="info-value">${phase.toFixed(1)} of 29.53</span></div><div class="info-pair"><span class="info-label">Days Until Full Moon</span><span class="info-value">${daysUntilFull} days</span></div><div class="info-pair"><span class="info-label">Days Until New Moon</span><span class="info-value">${daysUntilNew} days</span></div></div>`;
}

