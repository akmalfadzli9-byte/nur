<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>نور — Islamic Platform | Quran · Hadith (fawazahmed0) · Prayer · Qibla · Asma · Moon · Geo</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Cinzel+Decorative:wght@400;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg: #0a0d14;
    --surface: rgba(255,255,255,0.04);
    --surface2: rgba(255,255,255,0.08);
    --border: rgba(255,255,255,0.10);
    --gold: #c9a84c;
    --gold2: #e8c97e;
    --teal: #3ecfb2;
    --text: #e8e4d9;
    --text2: #9a9486;
    --error: #e05a5a;
    --radius: 16px;
    --shadow: 0 8px 40px rgba(0,0,0,0.6);
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Lato', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    overflow-x: hidden;
  }
  .bg-layer {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background:
      radial-gradient(ellipse 80% 60% at 20% 0%, rgba(201,168,76,0.08) 0%, transparent 60%),
      radial-gradient(ellipse 60% 50% at 80% 100%, rgba(62,207,178,0.06) 0%, transparent 55%),
      radial-gradient(ellipse 100% 80% at 50% 50%, rgba(10,13,20,1) 40%, transparent 100%);
  }
  .bg-grid {
    position: fixed; inset: 0; z-index: 0; pointer-events: none; opacity: 0.04;
    background-image: linear-gradient(rgba(201,168,76,0.5) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(201,168,76,0.5) 1px, transparent 1px);
    background-size: 60px 60px;
  }
  #app { position: relative; z-index: 1; max-width: 960px; margin: 0 auto; padding: 0 16px 60px; }
  header { text-align: center; padding: 48px 0 32px; position: relative; }
  header::after { content: ''; display: block; width: 180px; height: 1px; background: linear-gradient(90deg, transparent, var(--gold), transparent); margin: 20px auto 0; }
  .logo-arabic { font-family: 'Amiri', serif; font-size: clamp(48px, 10vw, 80px); color: var(--gold); line-height: 1; text-shadow: 0 0 40px rgba(201,168,76,0.3); }
  .logo-sub { font-family: 'Cinzel Decorative', serif; font-size: clamp(11px, 2.5vw, 14px); letter-spacing: 0.35em; color: var(--text2); text-transform: uppercase; margin-top: 6px; }
  .tabs { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; margin-bottom: 28px; }
  .tab { background: var(--surface); border: 1px solid var(--border); color: var(--text2); padding: 9px 18px; border-radius: 50px; cursor: pointer; font-family: 'Lato', sans-serif; font-size: 13px; letter-spacing: 0.06em; transition: all 0.25s ease; white-space: nowrap; }
  .tab:hover { border-color: var(--gold); color: var(--gold); }
  .tab.active { background: linear-gradient(135deg, rgba(201,168,76,0.2), rgba(201,168,76,0.08)); border-color: var(--gold); color: var(--gold2); box-shadow: 0 0 20px rgba(201,168,76,0.15); }
  .panel { display: none; animation: fadeIn 0.35s ease; }
  .panel.active { display: block; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; margin-bottom: 16px; backdrop-filter: blur(12px); box-shadow: var(--shadow); transition: border-color 0.2s; }
  .card:hover { border-color: rgba(201,168,76,0.25); }
  .card-title { font-family: 'Cinzel Decorative', serif; font-size: 11px; letter-spacing: 0.3em; color: var(--gold); text-transform: uppercase; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
  .card-title::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, var(--gold), transparent); opacity: 0.3; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
  input, select, textarea { background: var(--surface2); border: 1px solid var(--border); border-radius: 10px; color: var(--text); font-family: 'Lato', sans-serif; font-size: 14px; padding: 10px 14px; outline: none; transition: border-color 0.2s; flex: 1; min-width: 0; }
  input:focus, select:focus, textarea:focus { border-color: var(--gold); }
  select option { background: #1a1d24; }
  .btn { background: linear-gradient(135deg, var(--gold), #a8863a); border: none; border-radius: 10px; color: #0a0d14; cursor: pointer; font-family: 'Lato', sans-serif; font-size: 13px; font-weight: 700; letter-spacing: 0.06em; padding: 10px 20px; transition: all 0.2s ease; white-space: nowrap; }
  .btn:hover { filter: brightness(1.15); transform: translateY(-1px); box-shadow: 0 4px 20px rgba(201,168,76,0.3); }
  .btn-ghost { background: var(--surface2); border: 1px solid var(--border); border-radius: 10px; color: var(--text2); cursor: pointer; font-family: 'Lato', sans-serif; font-size: 13px; padding: 10px 20px; transition: all 0.2s; }
  .btn-ghost:hover { border-color: var(--teal); color: var(--teal); }
  .btn-icon { background: var(--surface2); border: 1px solid var(--border); border-radius: 8px; color: var(--teal); cursor: pointer; font-size: 14px; padding: 6px 10px; transition: all 0.2s; }
  .btn-icon:hover { background: rgba(62,207,178,0.15); border-color: var(--teal); }
  .badge { display: inline-block; background: rgba(201,168,76,0.15); border: 1px solid rgba(201,168,76,0.3); border-radius: 20px; color: var(--gold2); font-size: 11px; padding: 2px 10px; letter-spacing: 0.05em; }
  .badge-teal { background: rgba(62,207,178,0.1); border-color: rgba(62,207,178,0.3); color: var(--teal); }
  .badge-green { background: rgba(76,201,130,0.1); border-color: rgba(76,201,130,0.3); color: #4cc982; }
  .badge-red { background: rgba(224,90,90,0.1); border-color: rgba(224,90,90,0.3); color: var(--error); }
  .loader { text-align: center; padding: 40px; color: var(--text2); font-size: 13px; }
  .spinner { display: inline-block; width: 28px; height: 28px; border: 2px solid var(--border); border-top-color: var(--gold); border-radius: 50%; animation: spin 0.7s linear infinite; margin-bottom: 12px; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .error-box { background: rgba(224,90,90,0.08); border: 1px solid rgba(224,90,90,0.25); border-radius: 10px; color: var(--error); font-size: 13px; padding: 12px 16px; margin-top: 12px; }
  .verse-item { border-bottom: 1px solid var(--border); padding: 20px 0; }
  .verse-number { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; background: rgba(201,168,76,0.12); border: 1px solid rgba(201,168,76,0.25); border-radius: 50%; font-size: 11px; color: var(--gold); font-weight: 700; margin-bottom: 12px; }
  .arabic-text { font-family: 'Amiri', serif; font-size: 26px; line-height: 1.8; color: var(--text); text-align: right; direction: rtl; margin-bottom: 10px; word-spacing: 6px; }
  .translation-text { font-size: 14px; line-height: 1.7; color: var(--text2); font-style: italic; }
  .surah-header { text-align: center; padding: 20px; border-bottom: 1px solid var(--border); margin-bottom: 20px; }
  .surah-name-ar { font-family: 'Amiri', serif; font-size: 36px; color: var(--gold); direction: rtl; }
  .bismillah { text-align: center; font-family: 'Amiri', serif; font-size: 28px; color: var(--gold); direction: rtl; padding: 16px 0; }
  .hadith-item { border-bottom: 1px solid var(--border); padding: 20px 0; }
  .hadith-arabic { font-family: 'Amiri', serif; font-size: 20px; line-height: 1.8; color: var(--text); text-align: right; direction: rtl; margin: 10px 0; }
  .hadith-translation { font-size: 14px; line-height: 1.7; color: var(--text2); margin: 8px 0; }
  .hadith-meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .prayer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; margin-top: 16px; }
  .prayer-item { background: var(--surface2); border: 1px solid var(--border); border-radius: 12px; text-align: center; padding: 16px 10px; transition: all 0.2s; }
  .prayer-item.next { border-color: var(--gold); background: rgba(201,168,76,0.08); }
  .prayer-name { font-size: 11px; letter-spacing: 0.12em; color: var(--text2); text-transform: uppercase; margin-bottom: 6px; }
  .prayer-time { font-size: 22px; font-weight: 300; color: var(--text); }
  .hijri-date { text-align: center; font-size: 14px; color: var(--teal); margin-top: 14px; font-family: 'Amiri', serif; }
  .qibla-compass { position: relative; width: 180px; height: 180px; margin: 20px auto; }
  .compass-ring { position: absolute; inset: 0; border: 2px solid var(--border); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  .compass-ring::before { content: 'N'; position: absolute; top: 6px; font-size: 11px; font-weight: 700; color: var(--error); }
  .compass-ring::after { content: 'S'; position: absolute; bottom: 6px; font-size: 11px; color: var(--text2); }
  .compass-needle { position: absolute; width: 4px; height: 80px; left: 50%; top: 50%; transform-origin: bottom center; background: linear-gradient(180deg, var(--gold) 0%, transparent 100%); border-radius: 2px 2px 0 0; transform: translate(-50%, -100%) rotate(0deg); transition: transform 1s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .compass-center { width: 12px; height: 12px; background: var(--gold); border-radius: 50%; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); }
  .compass-e { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); font-size: 11px; color: var(--text2); }
  .compass-w { position: absolute; left: 6px; top: 50%; transform: translateY(-50%); font-size: 11px; color: var(--text2); }
  .qibla-degrees { font-size: 42px; font-weight: 300; color: var(--gold); line-height: 1; }
  .asma-card { text-align: center; padding: 40px 24px; }
  .asma-arabic { font-family: 'Amiri', serif; font-size: 64px; color: var(--gold); direction: rtl; margin-bottom: 12px; }
  .asma-number { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; background: rgba(201,168,76,0.1); border-radius: 50%; color: var(--gold); font-size: 14px; font-weight: 700; margin-bottom: 16px; }
  .moon-display { text-align: center; padding: 24px; }
  .moon-emoji { font-size: 80px; margin-bottom: 12px; filter: drop-shadow(0 0 20px rgba(201,168,76,0.3)); }
  .moon-phase-name { font-family: 'Cinzel Decorative', serif; font-size: 18px; color: var(--gold2); }
  .info-pair { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border); }
  .coord-display { background: var(--surface2); border-radius: 10px; padding: 14px; font-family: monospace; font-size: 14px; color: var(--teal); text-align: center; margin-top: 12px; }
  .sub-tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 14px; }
  .sub-tab { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; color: var(--text2); cursor: pointer; font-size: 11px; padding: 5px 12px; transition: all 0.2s; }
  .sub-tab.active { background: rgba(62,207,178,0.1); border-color: var(--teal); color: var(--teal); }
  .toast { position: fixed; bottom: 24px; right: 24px; background: var(--surface2); border: 1px solid var(--gold); border-radius: 12px; color: var(--gold2); font-size: 13px; padding: 12px 20px; z-index: 999; backdrop-filter: blur(12px); animation: slideUp 0.3s ease; }
  @keyframes slideUp { from { opacity:0; transform: translateY(20px); } to { opacity:1; transform: translateY(0); } }
  mark { background: rgba(201,168,76,0.35); color: var(--gold2); border-radius: 3px; padding: 0 2px; }
  @media (max-width: 600px) { .prayer-grid { grid-template-columns: repeat(3, 1fr); } .arabic-text { font-size: 22px; } .asma-arabic { font-size: 48px; } }
</style>
</head>
<body>
<div class="bg-layer"></div><div class="bg-grid"></div>
<div id="app">
  <header><div class="logo-arabic">نور</div><div class="logo-sub">Islamic Platform</div></header>
  <nav class="tabs">
    <button class="tab active" onclick="showPanel('quran')">📖 Quran</button>
    <button class="tab" onclick="showPanel('hadith')">🕊️ Hadith (fawazahmed0)</button>
    <button class="tab" onclick="showPanel('prayer')">🕌 Prayer & Qibla</button>
    <button class="tab" onclick="showPanel('asma')">✨ Asma Al-Husna</button>
    <button class="tab" onclick="showPanel('moon')">🌙 Moon Phase</button>
    <button class="tab" onclick="showPanel('geo')">🌍 Geo Info</button>
  </nav>

  <!-- Quran -->
  <div id="panel-quran" class="panel active">
    <div class="card"><div class="card-title">Browse Surah</div>
      <div class="row"><select id="surahSelect"></select><select id="translationSelect"><option value="en.sahih">Sahih International</option><option value="en.pickthall">Pickthall</option><option value="en.yusufali">Yusuf Ali</option></select><button class="btn" onclick="loadSurah()">Load Surah</button></div>
    </div>
    <div class="card"><div class="card-title">Search Quran</div><div class="row"><input id="quranSearch" type="text" placeholder="English keyword..."/><button class="btn" onclick="searchQuran()">Search</button></div><div id="quranSearchResults"></div></div>
    <div id="quranOutput"></div>
  </div>

  <!-- Hadith (fawazahmed0 API using raw JSON from GitHub/jsDelivr) -->
  <div id="panel-hadith" class="panel">
    <div class="card"><div class="card-title">Hadith Explorer — fawazahmed0/Hadith-API</div>
      <div class="sub-tabs" id="collectionTabs">
        <button class="sub-tab active" onclick="selectCollection('bukhari',this)">Bukhari</button>
        <button class="sub-tab" onclick="selectCollection('muslim',this)">Muslim</button>
        <button class="sub-tab" onclick="selectCollection('abudawud',this)">Abu Dawud</button>
        <button class="sub-tab" onclick="selectCollection('tirmidhi',this)">Tirmidhi</button>
        <button class="sub-tab" onclick="selectCollection('nasai',this)">Nasai</button>
        <button class="sub-tab" onclick="selectCollection('ibnmajah',this)">Ibn Majah</button>
      </div>
      <div class="row"><input id="hadithSearch" type="text" placeholder="Search keyword (e.g. mercy, prayer)"/><button class="btn" onclick="searchHadith()">Search</button><button class="btn-ghost" onclick="randomHadith()">🎲 Random</button></div>
      <div style="font-size:11px; color:var(--text2); margin-top:8px;">⚡ Using fawazahmed0's Hadith API (authentic collections, client‑side search)</div>
    </div>
    <div id="hadithOutput"></div>
  </div>

  <!-- Prayer + Qibla -->
  <div id="panel-prayer" class="panel">
    <div class="card"><div class="card-title">Prayer Times</div><div class="row"><input id="cityInput" value="Mecca"/><input id="countryInput" value="Saudi Arabia"/><button class="btn" onclick="getPrayerByCity()">Get Times</button><button class="btn-ghost" onclick="getPrayerByLocation()">📍 My Location</button></div></div>
    <div id="prayerOutput"></div>
    <div class="card"><div class="card-title">Qibla Direction</div><div class="row"><input id="qiblaLat" placeholder="Latitude"/><input id="qiblaLon" placeholder="Longitude"/><button class="btn" onclick="getQibla()">Calculate</button></div><div id="qiblaOutput"></div></div>
  </div>

  <!-- Asma Al-Husna (embedded static) -->
  <div id="panel-asma" class="panel"><div class="card"><div class="card-title">99 Names of Allah</div><div style="text-align:center;margin-bottom:16px;"><button class="btn" onclick="loadRandomAsma()">ﷲ Show Random Name</button><button class="btn-ghost" style="margin-left:8px;" onclick="loadAllAsma()">Show All 99</button></div><div id="asmaOutput"></div></div></div>

  <!-- Moon Phase -->
  <div id="panel-moon" class="panel"><div class="card"><div class="card-title">Today's Moon Phase</div><div id="moonOutput"></div></div></div>

  <!-- Geo Info (Nominatim OSM) -->
  <div id="panel-geo" class="panel"><div class="card"><div class="card-title">Geo Information</div><div class="row"><input id="geoAddress" placeholder="Address (e.g. Medina, Saudi Arabia)"/><button class="btn" onclick="getGeo()">Get Coordinates</button></div><div id="geoOutput"></div></div></div>
</div>
<audio id="audioPlayer"></audio>
<script>
// =============================== UTILS ===============================
function showToast(msg, dur=3000){ let t=document.createElement('div'); t.className='toast'; t.textContent=msg; document.body.appendChild(t); setTimeout(()=>t.remove(),dur); }
function loader(html=''){ return `<div class="loader"><div class="spinner"></div><br/>Loading…</div>`; }
function errorBox(msg){ return `<div class="error-box">⚠️ ${msg}</div>`; }
function gradeClass(grade){ if(!grade) return ''; const g=grade.toLowerCase(); if(g.includes('sahih')) return 'badge-green'; if(g.includes('hasan')) return 'badge-teal'; if(g.includes('daif')||g.includes('weak')) return 'badge-red'; return 'badge-teal'; }
function highlight(text, kw){ if(!kw) return text; let re=new RegExp(`(${kw.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')})`,'gi'); return text.replace(re,'<mark>$1</mark>'); }

async function fetchWithRetry(url, retries=2, delay=800){ for(let i=0;i<=retries;i++){ try{ const res=await fetch(url,{signal:AbortSignal.timeout(12000)}); if(!res.ok) throw new Error(`HTTP ${res.status}`); return res; } catch(e){ if(i===retries) throw e; await new Promise(r=>setTimeout(r,delay*(i+1))); } } }

function showPanel(id){
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.getElementById('panel-'+id).classList.add('active');
  document.getElementById('tab-'+id).classList.add('active');
  if(id==='moon') renderMoon();
}

// =============================== QURAN (AlQuran Cloud) ===============================
let surahList=[];
async function loadSurahList(){
  try{ let res=await fetchWithRetry('https://api.alquran.cloud/v1/surah'); let data=await res.json(); surahList=data.data; let sel=document.getElementById('surahSelect'); surahList.forEach(s=>{let opt=document.createElement('option'); opt.value=s.number; opt.textContent=`${s.number}. ${s.englishName} — ${s.name}`; sel.appendChild(opt);}); } catch(e){ console.error(e);}
}
let currentAudio=document.getElementById('audioPlayer'),playingBtn=null;
function playVerse(verseNum,url,btn){
  if(playingBtn&&playingBtn!==btn){ playingBtn.textContent='▶'; playingBtn.classList.remove('playing'); }
  if(currentAudio.src.includes(url)&&!currentAudio.paused){ currentAudio.pause(); btn.textContent='▶'; btn.classList.remove('playing'); playingBtn=null; return; }
  currentAudio.src=url; currentAudio.play().then(()=>{ btn.textContent='⏸'; btn.classList.add('playing'); playingBtn=btn; }).catch(()=>showToast('Audio unavailable'));
  currentAudio.onended=()=>{ btn.textContent='▶'; btn.classList.remove('playing'); playingBtn=null; };
}
async function loadSurah(){
  let num=document.getElementById('surahSelect').value; let trans=document.getElementById('translationSelect').value;
  if(!num){ showToast('Select surah'); return; }
  let out=document.getElementById('quranOutput'); out.innerHTML=loader();
  try{ let [arRes,trRes]=await Promise.all([fetchWithRetry(`https://api.alquran.cloud/v1/surah/${num}`), fetchWithRetry(`https://api.alquran.cloud/v1/surah/${num}/${trans}`)]);
    let arData=await arRes.json(); let trData=await trRes.json(); let surah=arData.data; let verses=surah.ayahs; let tVerses=trData.data.ayahs;
    let html=`<div class="card"><div class="surah-header"><div class="surah-name-ar">${surah.name}</div><div class="surah-meta">${surah.englishName} · ${surah.numberOfAyahs} verses</div></div>`;
    if(surah.number!==9) html+=`<div class="bismillah">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>`;
    verses.forEach((v,i)=>{ let tr=tVerses[i]; let audioUrl=`https://cdn.islamic.network/quran/audio/128/ar.alafasy/${v.number}.mp3`;
      html+=`<div class="verse-item"><div class="verse-number">${v.numberInSurah}</div><button class="btn-icon" id="play-${v.number}" onclick="playVerse(${v.number},'${audioUrl}',this)">▶</button><div class="arabic-text">${v.text}</div><div class="translation-text">${tr?tr.text:''}</div></div>`;
    }); html+='</div>'; out.innerHTML=html;
  }catch(e){ out.innerHTML=errorBox('Failed to load surah');}
}
async function searchQuran(){
  let q=document.getElementById('quranSearch').value.trim(); if(!q) return;
  let out=document.getElementById('quranSearchResults'); out.innerHTML=loader();
  try{ let res=await fetchWithRetry(`https://api.alquran.cloud/v1/search/${encodeURIComponent(q)}/all/en`); let data=await res.json(); let matches=data.data?.matches||[];
    if(!matches.length){ out.innerHTML=`<div>No results for "${q}"</div>`; return; }
    let html=`<div class="results-count">${matches.length} results</div>`; matches.slice(0,25).forEach(m=>{ html+=`<div class="search-result-item"><div class="search-result-ref">${m.surah.englishName} — verse ${m.numberInSurah}</div><div class="translation-text">${highlight(m.text,q)}</div></div>`; });
    out.innerHTML=html;
  }catch(e){ out.innerHTML=errorBox('Search failed'); }
}

// =============================== HADITH (fawazahmed0/Hadith-API) ===============================
// Using jsDelivr CDN for the raw JSON files (no API key, reliable CORS)
// File structure: https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@1/editions/eng-{collection}.min.json
// and ara-{collection}.min.json for Arabic.
let currentCollection = 'bukhari';
let hadithCache = {}; // store { eng: data, ara: data }

function selectCollection(name, el){
  currentCollection = name;
  document.querySelectorAll('.sub-tab').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
}

async function fetchHadithData(collection, lang='eng') {
  const cacheKey = `${lang}_${collection}`;
  if (hadithCache[cacheKey]) return hadithCache[cacheKey];
  const url = `https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@1/editions/${lang}-${collection}.min.json`;
  try {
    const res = await fetchWithRetry(url);
    const data = await res.json();
    hadithCache[cacheKey] = data;
    return data;
  } catch(e) {
    console.error(`Failed to load ${lang} ${collection}:`, e);
    return null;
  }
}

async function searchHadith() {
  const keyword = document.getElementById('hadithSearch').value.trim().toLowerCase();
  const out = document.getElementById('hadithOutput');
  if (!keyword) { out.innerHTML = errorBox('Enter a keyword to search.'); return; }
  out.innerHTML = loader();
  try {
    const [engData, araData] = await Promise.all([
      fetchHadithData(currentCollection, 'eng'),
      fetchHadithData(currentCollection, 'ara')
    ]);
    if (!engData || !engData.hadiths) throw new Error('No data for this collection');
    const hadiths = engData.hadiths;
    const arabicMap = araData?.hadiths || {};
    const results = [];
    for (let i = 0; i < hadiths.length; i++) {
      const h = hadiths[i];
      const text = (h.text || '').toLowerCase();
      const ref = (h.reference || '').toLowerCase();
      if (text.includes(keyword) || ref.includes(keyword)) {
        results.push({ index: i, eng: h, arab: arabicMap[i] });
      }
      if (results.length >= 30) break;
    }
    if (results.length === 0) {
      out.innerHTML = errorBox(`No hadith found for "${keyword}" in ${currentCollection}.`);
      return;
    }
    let html = `<div class="card"><div class="results-count">${results.length} result(s) for "${keyword}"</div>`;
    for (let r of results) {
      const eng = r.eng;
      const arabText = r.arab?.text || '';
      const grade = eng.grade || '';
      const narrator = eng.narrator || eng.narrators || '';
      const reference = eng.reference || '';
      html += `<div class="hadith-item">
        <div class="hadith-meta">
          ${reference ? `<span class="badge">📚 ${reference}</span>` : ''}
          ${grade ? `<span class="badge ${gradeClass(grade)}">${grade}</span>` : ''}
          ${narrator ? `<span class="badge badge-teal">👤 ${narrator}</span>` : ''}
        </div>
        ${arabText ? `<div class="hadith-arabic">${arabText}</div>` : ''}
        <div class="hadith-translation">${highlight(eng.text, keyword)}</div>
      </div>`;
    }
    html += '</div>';
    out.innerHTML = html;
  } catch(e) {
    out.innerHTML = errorBox('Failed to load hadith. Please try again. ' + e.message);
  }
}

