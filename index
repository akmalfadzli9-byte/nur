async function getPrayerByCity(){
  let city=document.getElementById('cityInput').value.trim(); let country=document.getElementById('countryInput').value.trim();
  if(!city){ showToast('Enter city'); return; } let out=document.getElementById('prayerOutput'); out.innerHTML=loader();
  try{ let res=await fetchWithRetry(`https://api.aladhan.com/v1/timingsByCity?city=${encodeURIComponent(city)}&country=${encodeURIComponent(country)}&method=2`); let data=await res.json();
    if(data.code!==200) throw new Error(data.status); renderPrayer(data.data,`${city}, ${country}`);
  }catch(e){ out.innerHTML=errorBox('Prayer times error: '+e.message); }
}
async function getPrayerByLocation(){
  if(!navigator.geolocation){ showToast('Geolocation not supported'); return; }
  let out=document.getElementById('prayerOutput'); out.innerHTML=loader();
  navigator.geolocation.getCurrentPosition(async pos=>{
    let {latitude:lat,longitude:lon}=pos.coords; document.getElementById('qiblaLat').value=lat.toFixed(6); document.getElementById('qiblaLon').value=lon.toFixed(6);
    try{ let res=await fetchWithRetry(`https://api.aladhan.com/v1/timings?latitude=${lat}&longitude=${lon}&method=2`); let data=await res.json(); if(data.code!==200) throw new Error(data.status); renderPrayer(data.data,`${lat.toFixed(2)}, ${lon.toFixed(2)}`); }
    catch(e){ out.innerHTML=errorBox('Location prayer times failed'); }
  },()=>{ out.innerHTML=errorBox('Location denied'); });
}
function renderPrayer(data,loc){
  let timings=data.timings; let hijri=data.date.hijri; let now=new Date(); let nowMins=now.getHours()*60+now.getMinutes();
  let prayers=[{name:'Fajr',key:'Fajr'},{name:'Sunrise',key:'Sunrise'},{name:'Dhuhr',key:'Dhuhr'},{name:'Asr',key:'Asr'},{name:'Maghrib',key:'Maghrib'},{name:'Isha',key:'Isha'}];
  let nextIdx=-1; prayers.forEach((p,i)=>{ let [h,m]=timings[p.key].split(':').map(Number); let mins=h*60+m; if(nextIdx===-1 && mins>nowMins) nextIdx=i; });
  let html=`<div class="card"><div class="card-title">${loc}</div><div class="prayer-grid">`;
  prayers.forEach((p,i)=>{ let t=timings[p.key].substring(0,5); html+=`<div class="prayer-item ${i===nextIdx?'next':''}"><div class="prayer-name">${p.name}</div><div class="prayer-time">${t}</div></div>`; });
  html+=`</div><div class="hijri-date">${hijri.day} ${hijri.month.en} ${hijri.year} AH · ${hijri.month.ar}</div></div>`;
  document.getElementById('prayerOutput').innerHTML=html;
}
async function getQibla(){
  let lat=parseFloat(document.getElementById('qiblaLat').value); let lon=parseFloat(document.getElementById('qiblaLon').value);
  if(isNaN(lat)||isNaN(lon)){ showToast('Enter valid coordinates'); return; }
  let out=document.getElementById('qiblaOutput'); out.innerHTML=loader();
  try{ let res=await fetchWithRetry(`https://api.aladhan.com/v1/qibla/${lat}/${lon}`); let data=await res.json(); if(data.code!==200) throw new Error(data.status); let deg=data.data.direction;
    let dirs=['N','NNE','NE','ENE','E','ESE','SE','SSE','S','SSW','SW','WSW','W','WNW','NW','NNW']; let card=dirs[Math.round(deg/22.5)%16];
    let html=`<div style="display:flex;align-items:center;gap:32px;flex-wrap:wrap;justify-content:center;margin-top:16px;"><div class="qibla-compass"><div class="compass-ring"><span class="compass-e">E</span><span class="compass-w">W</span><div class="compass-needle" id="compassNeedle"></div><div class="compass-center"></div></div></div><div class="qibla-info"><div class="qibla-degrees">${deg.toFixed(1)}°</div><div class="qibla-direction">${card} from North</div><div style="color:var(--gold2);font-family:'Amiri';margin-top:10px;">🕋 الكعبة</div></div></div>`;
    out.innerHTML=html; setTimeout(()=>{ let n=document.getElementById('compassNeedle'); if(n) n.style.transform=`translate(-50%, -100%) rotate(${deg}deg)`; },100);
  }catch(e){ out.innerHTML=errorBox('Qibla failed'); }
}

