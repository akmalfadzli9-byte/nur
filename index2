renderFaraidCards();
function getFInt(id){ let v=parseInt(faraidInputs[id]?.value,10); return isNaN(v)||v<0?0:v; }
function updateFaraidNotes(){
  let sons=getFInt('sons'), daughters=getFInt('daughters'), father=getFInt('father'), mother=getFInt('mother'), husband=getFInt('husband'), wife=getFInt('wife');
  let fullB=getFInt('fullBrothers'), fullS=getFInt('fullSisters'), patB=getFInt('paternalBrothers'), patS=getFInt('paternalSisters'), matSib=getFInt('maternalSiblings');
  let grandfather=getFInt('grandfather'), grandmother=getFInt('grandmother');
  let hasChildren=(sons+daughters)>0, hasSons=sons>0, fatherExists=father>0, motherExists=mother>0, blockSiblings=hasChildren||fatherExists;
  let totalSiblings=fullB+fullS+patB+patS+matSib;
  let ctx={hasChildren,hasSons,daughters,blockSiblings,fatherExists,motherExists,hasChildrenOrMultipleSiblings:hasChildren||totalSiblings>=2,fullBrothers:fullB,fullSisters:fullS,paternalBrothers:patB,paternalSisters:patS,maternalCount:matSib,hasChildrenOrFather:hasChildren||fatherExists};
  heirConfig.forEach(c=>{ let noteDiv=document.getElementById(`note_${c.id}`); if(noteDiv) noteDiv.innerText = typeof c.note==='function'?c.note(ctx):''; });
  let names=[]; heirConfig.forEach(c=>{ if(getFInt(c.id)>0) names.push(`${c.label} (${getFInt(c.id)})`); });
