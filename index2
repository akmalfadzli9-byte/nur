// =============================== FARAID LOGIC ===============================
const heirGroups = { pasanganAnak: ['husband','wife','sons','daughters'], ibuBapa: ['father','mother','grandfather','grandmother'], adik: ['fullBrothers','fullSisters','paternalBrothers','paternalSisters','maternalSiblings'] };
const heirConfig = [
  { id:'husband', label:'Suami', max:1, default:0, note: ctx=> ctx.hasChildren?'1/4':'1/2', group:'pasanganAnak' },
  { id:'wife', label:'Isteri', max:4, default:0, note: ctx=> ctx.hasChildren?'1/8':'1/4', group:'pasanganAnak' },
  { id:'sons', label:'Anak Lelaki', max:99, default:0, note: ()=>'Asabah (2:1)', group:'pasanganAnak' },
  { id:'daughters', label:'Anak Perempuan', max:99, default:0, note: ctx=> ctx.hasSons?'Asabah':(ctx.daughters===1?'1/2':'2/3'), group:'pasanganAnak' },
  { id:'father', label:'Bapa', max:1, default:0, note: ctx=> ctx.hasChildren?'1/6':'Asabah', group:'ibuBapa' },
  { id:'mother', label:'Ibu', max:1, default:0, note: ctx=> ctx.hasChildrenOrMultipleSiblings?'1/6':'1/3', group:'ibuBapa' },
  { id:'grandfather', label:'Datuk', max:1, default:0, note: ctx=> ctx.fatherExists?'Terhalang':(ctx.hasChildren?'1/6':'Asabah'), group:'ibuBapa' },
  { id:'grandmother', label:'Nenek', max:1, default:0, note: ctx=> ctx.motherExists?'Terhalang':'1/6', group:'ibuBapa' },
  { id:'fullBrothers', label:'Adik kandung (L)', max:99, default:0, note: ctx=> ctx.blockSiblings?'Terhalang':'Asabah', group:'adik' },
  { id:'fullSisters', label:'Adik kandung (P)', max:99, default:0, note: ctx=> ctx.blockSiblings?'Terhalang':(ctx.fullBrothers>0?'Asabah':(ctx.fullSisters===1?'1/2':'2/3')), group:'adik' },
  { id:'paternalBrothers', label:'Adik sebapa (L)', max:99, default:0, note: ctx=> ctx.blockSiblings||ctx.fullBrothers>0?'Terhalang':'Asabah', group:'adik' },
  { id:'paternalSisters', label:'Adik sebapa (P)', max:99, default:0, note: ctx=> ctx.blockSiblings||ctx.fullBrothers>0?'Terhalang':(ctx.paternalBrothers>0?'Asabah':(ctx.paternalSisters===1?'1/2':'2/3')), group:'adik' },
  { id:'maternalSiblings', label:'Adik seibu', max:99, default:0, note: ctx=> ctx.hasChildrenOrFather?'Terhalang':(ctx.maternalCount===1?'1/6':'1/3'), group:'adik' }
];
let faraidInputs = {};
function renderFaraidCards(){
  for(let [group, ids] of Object.entries(heirGroups)){
    let cont = document.getElementById(`grid-${group}`);
    if(!cont) continue;
    cont.innerHTML = ids.map(id=>{ let c=heirConfig.find(h=>h.id===id); return `<div class="heir-card"><div class="heir-label">${c.label} <span>0-${c.max}</span></div><div class="input-row"><label>Bil</label><input type="number" id="f_${c.id}" min="0" max="${c.max}" value="${c.default}" step="1"></div><div class="dynamic-note" id="note_${c.id}"></div></div>`; }).join('');
  }
