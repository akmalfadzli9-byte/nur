updateFaraidNotes();
function frac(n,d){ if(d===0) return {n:0,d:1}; let g=(a,b)=>b===0?a:g(b,a%b); let gcd=g(Math.abs(n),Math.abs(d)); return {n:n/gcd, d:d/gcd}; }
function add(f1,f2){ let d=f1.d*f2.d/gcd(f1.d,f2.d); return frac(f1.n*(d/f1.d)+f2.n*(d/f2.d), d); }
function sum(lst){ return lst.reduce((a,f)=>add(a,f), frac(0,1)); }
function format(f){ return f.n===0?'0':(f.d===1?`${f.n}`:`${f.n}/${f.d}`); }
function calculateFaraid(){
  updateFaraidNotes();
  let husband=Math.min(1,getFInt('husband')), wife=Math.min(4,getFInt('wife')), father=Math.min(1,getFInt('father')), mother=Math.min(1,getFInt('mother')), grandfather=Math.min(1,getFInt('grandfather')), grandmother=Math.min(1,getFInt('grandmother'));
  let sons=getFInt('sons'), daughters=getFInt('daughters'), fullB=getFInt('fullBrothers'), fullS=getFInt('fullSisters'), patB=getFInt('paternalBrothers'), patS=getFInt('paternalSisters'), matSib=getFInt('maternalSiblings');
  let hasChildren=(sons+daughters)>0, hasSons=sons>0, fatherExists=father>0, motherExists=mother>0, blockSiblings=hasChildren||fatherExists;
  let fixed=[];
  if(husband) fixed.push({heir:'Suami', fraction:hasChildren?frac(1,4):frac(1,2), count:1, isSpouse:true});
  if(wife) fixed.push({heir:'Isteri', fraction:hasChildren?frac(1,8):frac(1,4), count:wife, isSpouse:true});
  if(mother){ let share=null; if(hasChildren||(fullB+fullS+patB+patS+matSib)>=2) share=frac(1,6); else share=frac(1,3); if(share) fixed.push({heir:'Ibu', fraction:share, count:1}); }
  if(!motherExists&&grandmother) fixed.push({heir:'Nenek', fraction:frac(1,6), count:1});
  if(father&&hasChildren) fixed.push({heir:'Bapa', fraction:frac(1,6), count:1});
  let eGrandfather=(!fatherExists&&grandfather>0)?1:0;
  if(eGrandfather&&hasChildren) fixed.push({heir:'Datuk', fraction:frac(1,6), count:1});
  if(daughters>0&&!hasSons) fixed.push({heir:'Anak Perempuan', fraction:daughters===1?frac(1,2):frac(2,3), count:daughters});
  if(!blockSiblings&&matSib) fixed.push({heir:'Adik seibu', fraction:matSib===1?frac(1,6):frac(1,3), count:matSib});
  if(!blockSiblings&&fullS&&!fullB) fixed.push({heir:'Adik kandung (P)', fraction:fullS===1?frac(1,2):frac(2,3), count:fullS});
  if(!blockSiblings&&!fullB&&!fullS&&patS&&!patB) fixed.push({heir:'Adik sebapa (P)', fraction:patS===1?frac(1,2):frac(2,3), count:patS});
  let totalFardh=sum(fixed.map(f=>f.fraction)); let awl=false;
  if(totalFardh.n>totalFardh.d){ awl=true; let sNum=fixed.reduce((s,f)=>s+f.fraction.n,0); fixed.forEach(f=>f.fraction=frac(f.fraction.n, sNum)); totalFardh=frac(sNum,sNum); }
  let remainder=!awl?frac(totalFardh.d-totalFardh.n, totalFardh.d):frac(0,1);
  let asabah=[];
  if(hasSons||(daughters&&hasSons)){ if(sons) asabah.push({heir:'Anak Lelaki', count:sons, ratio:2}); if(daughters) asabah.push({heir:'Anak Perempuan', count:daughters, ratio:1}); }
  if(!hasChildren){ if(father&&!fixed.some(f=>f.heir==='Bapa')) asabah.push({heir:'Bapa', count:1, ratio:1}); else if(eGrandfather&&!fixed.some(f=>f.heir==='Datuk')) asabah.push({heir:'Datuk', count:1, ratio:1}); }
  if(!blockSiblings){ if(fullB) asabah.push({heir:'Adik kandung (L)', count:fullB, ratio:2}); if(fullB&&fullS) asabah.push({heir:'Adik kandung (P)', count:fullS, ratio:1}); if(!fullB&&patB) asabah.push({heir:'Adik sebapa (L)', count:patB, ratio:2}); if(!fullB&&!fullS&&patB&&patS) asabah.push({heir:'Adik sebapa (P)', count:patS, ratio:1}); }
  let asabahRes=[]; if(asabah.length&&remainder.n>0){ let totalRatio=asabah.reduce((s,a)=>s+a.count*a.ratio,0); asabah.forEach(a=>asabahRes.push({heir:a.heir, fraction:frac(remainder.n*a.count*a.ratio, remainder.d*totalRatio), count:a.count})); remainder=frac(0,1); }
  if(remainder.n>0&&!awl){ let eligible=fixed.filter(f=>!f.isSpouse); if(eligible.length){ let totalE=sum(eligible.map(e=>e.fraction)); if(totalE.n>0){ eligible.forEach(e=>{ let ratioN=e.fraction.n*totalE.d, ratioD=e.fraction.d*totalE.n; e.fraction=add(e.fraction, frac(remainder.n*ratioN, remainder.d*ratioD)); }); remainder=frac(0,1); } } }
  let all=[...fixed, ...asabahRes]; let merged=new Map(); all.forEach(r=>{ if(merged.has(r.heir)){ let e=merged.get(r.heir); e.fraction=add(e.fraction,r.fraction); e.count+=r.count; } else merged.set(r.heir,{...r}); });
  let final=Array.from(merged.values());
  let tbody=document.getElementById('faraidTableBody'); let html='', labels=[], values=[];
  final.forEach(r=>{ let perc=(r.fraction.n/r.fraction.d*100).toFixed(2); let disp=r.count>1?`${r.heir} (${r.count})`:r.heir; html+=`<tr><td>${disp}</td><td><span class="fraction">${format(r.fraction)}</span></td><td>${perc}%</td></tr>`; labels.push(disp); values.push(r.fraction.n/r.fraction.d); });
  tbody.innerHTML=html||'<tr><td colspan="3">Tiada waris</td></tr>';
  document.getElementById('totalFraction').innerText=format(sum(final.map(f=>f.fraction)))+(awl?' (ʻAwl)':'');
  document.getElementById('faraidMessage').innerHTML=awl?'✅ ‘Awl digunakan':(remainder.n>0?`⚠️ Baki ${format(remainder)}`:'✅ Pembahagian lengkap.');
  if(window.faraidChart) window.faraidChart.destroy();
  let ctxChart=document.getElementById('faraidChart').getContext('2d');
  window.faraidChart=new Chart(ctxChart,{type:'pie',data:{labels,datasets:[{data:values,backgroundColor:['#2b5a44','#6f8f72','#a7b89a','#bfa88e','#d4bfae','#b59a7a']}]},options:{plugins:{legend:{position:'bottom'}}}});
}
function resetFaraid(){ heirConfig.forEach(c=>{if(faraidInputs[c.id]) faraidInputs[c.id].value=c.default;}); updateFaraidNotes(); calculateFaraid(); }

